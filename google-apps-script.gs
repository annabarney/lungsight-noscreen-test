const PARTICIPANT_ID_QUESTION='Study reference';
const CONSENT_QUESTION='Do you consent to take part in the Lungsight study?';
const REQUIRED_AFFIRMATIVE_ANSWER='Yes';
function onFormSubmit(e){const props=PropertiesService.getScriptProperties(),url=props.getProperty('LUNGSIGHT_WEBHOOK_URL'),secret=props.getProperty('LUNGSIGHT_WEBHOOK_SECRET');let participantId='',consentAffirmed=false;e.response.getItemResponses().forEach(r=>{const title=r.getItem().getTitle(),answer=r.getResponse();if(title===PARTICIPANT_ID_QUESTION)participantId=String(answer).trim();if(title===CONSENT_QUESTION){const a=Array.isArray(answer)?answer:[answer];consentAffirmed=a.map(String).includes(REQUIRED_AFFIRMATIVE_ANSWER)}});if(!/^LS-[A-HJ-NP-Z2-9]{20}$/.test(participantId)||!consentAffirmed)throw new Error('Valid study reference and affirmative consent not found.');const response=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',headers:{'x-lungsight-secret':secret},payload:JSON.stringify({participantId,consentAffirmed:true}),muteHttpExceptions:true});if(response.getResponseCode()!==200)throw new Error('Webhook failed: '+response.getContentText())}
